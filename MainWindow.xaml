        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="닉네임" VerticalAlignment="Center" Foreground="#AFC0DA" FontWeight="SemiBold"/>
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="MiniFlightNicknameBox" ToolTip="예: 준니" Margin="0,0,0,6"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="고유번호" VerticalAlignment="Center" Foreground="#AFC0DA" FontWeight="SemiBold"/>
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="MiniFlightUniqueBox" ToolTip="예: 101" Margin="0,0,0,6"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Text="항공기" VerticalAlignment="Center" Foreground="#AFC0DA" FontWeight="SemiBold"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="MiniFlightAircraftBox" ToolTip="예: 노란색 여객기" KeyDown="MiniFlightAircraftBox_KeyDown" Margin="0,0,0,8"/>

      <Button Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Primary}" Content="등록 + 자동 복사" Click="RegisterMiniFlight_Click" Margin="0"/>
    </Grid>
  </Border>
  <ListBox Grid.Row="1" x:Name="MiniFlightPermitList" MaxHeight="420" Margin="0,8,0,0">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <Border Background="#111D30" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,3">
          <StackPanel>
            <TextBlock Text="{Binding Header}" FontWeight="Bold"/>
            <Grid Margin="0,4,0,0">
              <TextBlock Text="{Binding RemainingText}" Foreground="{Binding StatusBrush}"/>
              <Button Content="15분 연장" Tag="{Binding}" Click="ExtendFlight_Click" HorizontalAlignment="Right" Padding="8,4"/>
            </Grid>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</Grid>
<Grid x:Name="MiniMacros" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource CompactCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="고번" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox Grid.Column="1" x:Name="MiniMacroUniqueBox"/><TextBlock Grid.Row="1" Text="닉네임" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="MiniMacroNicknameBox"/><TextBlock Grid.Row="2" Text="사유지명" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="MiniMacroPropertyBox"/></Grid></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="450" Margin="0,8,0,0">
<ItemsControl x:Name="MiniMacroCategoryGroups">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Expander Header="{Binding Name}" Style="{StaticResource MiniExpander}">
<ItemsControl ItemsSource="{Binding Items}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Button Content="{Binding Name}" Tag="{Binding}" Click="CopyMiniMacro_Click" HorizontalContentAlignment="Left"/>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</Expander>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</ScrollViewer></Grid>
</Grid></Grid></Border>
<Thumb x:Name="FullResizeThumb"
       Grid.RowSpan="3"
       Width="24" Height="24"
       HorizontalAlignment="Right" VerticalAlignment="Bottom"
       Cursor="SizeNWSE"
       Background="Transparent"
       DragDelta="FullResizeThumb_DragDelta"
       ToolTip="드래그하여 전체창 크기 조절">
    <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
            <Grid Background="Transparent">
                <Path Data="M 22,4 L 22,22 L 4,22 Z" Fill="#6B89B7" Opacity="0.85"/>
            </Grid>
        </ControlTemplate>
    </Thumb.Template>
</Thumb>
<Border x:Name="FooterRoot" Grid.Row="2" Background="#0C1423" Padding="14,7"><TextBlock Text="퍼펙트 경찰 v2.2.0   ·   미니창 상단 고정   ·   탭 전환 시 하단 높이만 변경" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Border>
</Grid></Window>